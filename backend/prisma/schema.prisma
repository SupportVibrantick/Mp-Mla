generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════

enum UserRole {
  SYSTEM_ADMIN
  MLA_MP
  OFFICE_STAFF
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_STAFF
  BILLING_MANAGER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PlanUpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PENDING
  RUNNING
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
  REJECTED
}

enum GrievancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  CLOSED
  PROPOSED
}

enum InstitutionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstitutionCategory {
  TEMPLE
  MOSQUE
  GURUDWARA
  CHURCH
  HOSPITAL
  CLINIC
  SCHOOL
  COLLEGE
  UNIVERSITY
  COACHING_CENTER
  POLICE_STATION
  FIRE_STATION
  LAW_OFFICE
  GOVT_OFFICE
  NGO
  GYM
  SPORTS_FACILITY
  COMMUNITY_HALL
  LIBRARY
  PUBLIC_LIBRARY
  BUS_STAND
  PARK
  MARKET
  RWA
  OLD_AGE_HOME
  STADIUM
  SKILL_DEVELOPMENT_CENTER
  CSC_CENTER
  OTHER
}

enum CommunityGroupType {
  MARKET
  SLUM
  SPORTS_TEAM
  CLUB
  RWA
  SENIOR_CITIZEN
  BUDDHIJEEVI
  WOMEN_GROUP
  YOUTH_GROUP
  CULTURAL_ORG
  NGO
  FESTIVAL_COMMITTEE
  TRADE_UNION
  OTHER
}

// enum SchemeStatus {
//   ACTIVE
//   EXPIRED
//   UPCOMING
//   SUSPENDED
// }

enum FundType {
  MPLAD
  MLALAD
  STATE_FUND
  CENTRAL_FUND
  CSR
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  IMPORT
  PASSWORD_CHANGE
  PERMISSION_CHANGE
  STATUS_CHANGE
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SEND_NOTIFICATION
  BACKUP
  RESTORE
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WardStatus {
  ACTIVE
  INACTIVE
  PROPOSED
  MERGED
  DELIMITATION_PENDING
}

enum WardAreaType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  AGRICULTURAL
  INSTITUTIONAL
  SLUM
  CANTONMENT
  OTHER
}

enum SocialCategory {
  GENERAL
  OBC
  SC
  ST
  MINORITY
  OTHER
}

// ════════════════════════════════════════════════════════
// ORGANIZATION & BRANDING
// ════════════════════════════════════════════════════════

model Organization {
  id               String  @id @default(cuid())
  name             String
  tagline          String?
  constituencyName String
  state            String
  district         String
  address          String?
  phone            String?
  email            String?
  website          String?
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String  @default("#1e40af")
  secondaryColor   String  @default("#3b82f6")

  representativeName  String
  representativeTitle String
  representativePhoto String?
  partyName           String?
  partyLogoUrl        String?
  termStartDate       DateTime?
  termEndDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// ════════════════════════════════════════════════════════
// TENANT (SaaS Multi-Tenancy Core)
// ════════════════════════════════════════════════════════

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  constituencyName    String
  state               String
  district            String
  address             String?
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String       @default("#1e40af")
  secondaryColor      String       @default("#3b82f6")

  representativeName  String
  representativeTitle String
  representativePhoto String?
  partyName           String?
  partyLogoUrl        String?
  termStartDate       DateTime?
  termEndDate         DateTime?

  status              TenantStatus @default(ACTIVE)
  maxUsers            Int          @default(5)
  storageQuotaMB      Int          @default(1024)
  storageUsedMB       Float        @default(0)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users               User[]
  subscription        TenantSubscription?
  moduleAccess        TenantModuleAccess[]
  wards               Ward[]
  grievances          Grievance[]
  projects            Project[]
  departments         Department[]
  leaders             Leader[]
  institutions        Institution[]
  institutionRequests InstitutionRequest[]
  communityGroups     CommunityGroup[]
  demographics        Demographics[]
  funds               Fund[]
  meetings            Meeting[]
  competitors         Competitor[]
  tasks               Task[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settings            TenantSetting[]
  ownMetrics          OwnMetricEntry[]
  planUpgradeRequests PlanUpgradeRequest[]

  @@index([status])
  @@map("tenants")
}

// ════════════════════════════════════════════════════════
// PLATFORM USERS (Master Dashboard)
// ════════════════════════════════════════════════════════

model PlatformUser {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String
  role        PlatformRole @default(SUPER_ADMIN)
  avatarUrl   String?
  isActive    Boolean      @default(true)
  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  refreshTokens RefreshToken[]
  reviewedPlanUpgradeRequests PlanUpgradeRequest[] @relation("PlanUpgradeRequestReviewedBy")

  @@index([role])
  @@index([isActive])
  @@map("platform_users")
}

// ════════════════════════════════════════════════════════
// SUBSCRIPTION, MODULES & PAYMENTS
// ════════════════════════════════════════════════════════

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique
  code          String   @unique
  description   String?
  priceMonthly  Float    @default(0)
  priceYearly   Float    @default(0)
  maxUsers      Int      @default(5)
  maxWards      Int      @default(10)
  storageMB     Int      @default(1024)
  features      Json     @default("[]")
  isActive      Boolean  @default(true)
  isPopular     Boolean  @default(false)
  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions TenantSubscription[]
  planModules   PlanModule[]
  currentUpgradeRequests PlanUpgradeRequest[] @relation("PlanUpgradeRequestCurrentPlan")
  requestedUpgradeRequests PlanUpgradeRequest[] @relation("PlanUpgradeRequestRequestedPlan")

  @@index([isActive])
  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  suspendedAt        DateTime?
  lastPaymentAt      DateTime?
  nextPaymentDue     DateTime?
  amountDue          Float              @default(0)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments           Payment[]

  @@index([status])
  @@index([nextPaymentDue])
  @@map("tenant_subscriptions")
}

model Module {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  category    String  @default("core")
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantAccess TenantModuleAccess[]
  planModules  PlanModule[]

  @@index([isActive])
  @@map("modules")
}

model TenantModuleAccess {
  id        String    @id @default(cuid())
  tenantId  String
  moduleId  String
  isEnabled Boolean   @default(true)
  grantedAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@map("tenant_module_access")
}

model PlanModule {
  id        String           @id @default(cuid())
  planId    String
  moduleId  String
  
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
  @@map("plan_modules")
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Float
  taxAmount      Float?
  gstNumber      String?
  currency       String        @default("INR")
  method         String?
  transactionId  String?
  status         PaymentStatus @default(PENDING)
  invoiceNumber  String?
  invoiceUrl     String?
  notes          String?
  paidAt         DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model PlanUpgradeRequest {
  id                    String                   @id @default(cuid())
  tenantId              String
  currentPlanId         String?
  requestedPlanId       String
  requestedBillingCycle BillingCycle?
  status                PlanUpgradeRequestStatus @default(PENDING)
  requesterName         String?
  requesterEmail        String?
  requesterPhone        String?
  tenantNote            String?
  adminNote             String?
  reviewedById          String?
  reviewedAt            DateTime?

  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentPlan           SubscriptionPlan?        @relation("PlanUpgradeRequestCurrentPlan", fields: [currentPlanId], references: [id])
  requestedPlan         SubscriptionPlan         @relation("PlanUpgradeRequestRequestedPlan", fields: [requestedPlanId], references: [id])
  reviewedBy            PlatformUser?            @relation("PlanUpgradeRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([requestedPlanId])
  @@index([createdAt])
  @@map("plan_upgrade_requests")
}

// ════════════════════════════════════════════════════════
// USERS & AUTH
// ════════════════════════════════════════════════════════

model User {
  id          String     @id @default(cuid())
  email       String
  phone       String?
  tenantId    String
  password    String
  name        String
  role        UserRole
  status      UserStatus @default(ACTIVE)
  avatarUrl   String?
  designation String?
  department  String?
  bio         String?

  // Security
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime  @default(now())
  forcePasswordChange Boolean   @default(false)

  // Who created this user
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByAdmin User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  usersCreated   User[] @relation("UserCreatedBy")

  permissions        UserPermission[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  tasksAssigned      Task[]           @relation("TaskAssignedTo")
  tasksCreated       Task[]           @relation("TaskCreatedBy")
  grievancesCreated  Grievance[]      @relation("GrievanceCreatedBy")
  grievancesAssigned Grievance[]      @relation("GrievanceAssignedTo")
  projectsCreated    Project[]        @relation("ProjectCreatedBy")
  notifications      Notification[]

  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@map("users")
}

model RefreshToken {
  id             String   @id @default(cuid())
  userId         String?
  platformUserId String?
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  isRevoked      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([platformUserId])
  @@map("refresh_tokens")
}

// ════════════════════════════════════════════════════════
// PERMISSIONS (Database-driven RBAC)
// ════════════════════════════════════════════════════════

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  description String?

  roleDefaults    RoleDefaultPermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RoleDefaultPermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String
  granted      Boolean  @default(true)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_default_permissions")
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ════════════════════════════════════════════════════════
// WARDS
// ════════════════════════════════════════════════════════

model Ward {
  id         String     @id @default(cuid())
  tenantId   String
  wardNumber Int
  name       String
  zone       String? // "A", "B", "C" etc.
  status     WardStatus @default(ACTIVE)
  isDeleted  Boolean    @default(false)

  // Aggregate fields (computed from areas, cached for performance)
  totalPopulation Int @default(0)
  totalHouseholds Int @default(0)
  totalAreas      Int @default(0)
  totalMale       Int @default(0)
  totalFemale     Int @default(0)

  areaType        String    @default("Urban") // Overall classification
  pincode         String?
  latitude        Float?
  longitude       Float?
  boundaryGeoJson Json? // GeoJSON polygon for map rendering
  description     String?
  establishedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  areas               WardArea[]
  councillors         WardCouncillor[]
  institutions        Institution[]
  grievances          Grievance[]
  projects            Project[]
  demographics        Demographics[]
  communityGroups     CommunityGroup[]
  // schemeBeneficiaries SchemeBeneficiary[]
  leaders             Leader[]
  institutionRequests InstitutionRequest[]

  @@unique([tenantId, wardNumber])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([status])
  @@index([isDeleted])
  @@index([zone])
  @@map("wards")
}

model WardArea {
  id          String       @id @default(cuid())
  wardId      String
  name        String
  areaType    WardAreaType @default(RESIDENTIAL)
  population  Int          @default(0)
  households  Int          @default(0)
  maleCount   Int          @default(0)
  femaleCount Int          @default(0)
  pincode     String?
  landmark    String?                                      
  description String?                                       
  latitude    Float?
  longitude   Float?
  isActive    Boolean      @default(true)
  isDeleted   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward            Ward             @relation(fields: [wardId], references: [id], onDelete: Cascade)
  demographics    Demographics[]
  communityGroups CommunityGroup[]

  @@unique([wardId, name])
  @@index([wardId])
  @@index([isDeleted])
  @@index([areaType])
  @@map("ward_areas")
}

model WardCouncillor {
  id          String    @id @default(cuid())
  wardId      String
  name        String
  phone       String?
  email       String?
  partyName   String?
  photoUrl    String?
  address     String?
  designation String    @default("Ward Councillor")
  sinceDate   DateTime?
  untilDate   DateTime? // null = currently active
  isCurrent   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@index([wardId])
  @@index([isCurrent])
  @@map("ward_councillors")
}

// ════════════════════════════════════════════════════════
// INSTITUTIONS
// ════════════════════════════════════════════════════════

model Institution {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  category        InstitutionCategory
  subcategory     String?
  address         String
  latitude        Float?
  longitude       Float?
  wardId          String
  contactNo       String?
  email           String?
  website         String?
  status          InstitutionStatus   @default(ACTIVE)
  isDeleted       Boolean             @default(false)
  description     String?
  photoUrl        String?
  capacity        Int?
  establishedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward      Ward       @relation(fields: [wardId], references: [id])
  incharges Incharge[]

  @@index([tenantId])
  @@index([wardId])
  @@index([category])
  @@index([status])
  @@index([isDeleted])
  @@map("institutions")
}

model Incharge {
  id            String    @id @default(cuid())
  institutionId String
  name          String
  designation   String
  contactNo     String
  email         String?
  dateOfBirth   DateTime?
  photoUrl      String?
  appointedDate DateTime?
  adharNumber   String?   @unique
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("incharges")
}

model InstitutionRequest {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  category        InstitutionCategory
  subcategory     String?
  address         String
  wardId          String
  contactNo       String?
  email           String?
  website         String?
  description     String?
  capacity        Int?
  establishedDate DateTime?

  // Submitter info
  submitterName  String
  submitterPhone String
  submitterEmail String?

  // Head/Incharge info
  headName          String
  headDesignation   String
  headContact       String
  headEmail         String?
  headDateOfBirth   DateTime?
  headAdharNumber   String?
  headAppointedDate DateTime?

  // KYC Documents (JSON array of {name, url, type})
  documents Json? @default("[]")

  // Approval workflow
  status          InstitutionRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  institutionId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([wardId])
  @@index([createdAt])
  @@map("institution_requests")
}

// ════════════════════════════════════════════════════════
// COMMUNITY GROUPS
// ════════════════════════════════════════════════════════

model CommunityGroup {
  id              String             @id @default(cuid())
  tenantId        String
  name            String
  type            CommunityGroupType
  wardId          String
  wardAreaId      String? // optional: linked to specific area
  address         String?
  description     String?
  memberCount     Int?
  maleMembers     Int?
  femaleMembers   Int?
  headName        String?
  headPhone       String?
  headEmail       String?
  headDesignation String?
  headPhotoUrl    String?
  foundedDate     DateTime?
  registrationNo  String?
  isActive        Boolean            @default(true)
  isDeleted       Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward     Ward      @relation(fields: [wardId], references: [id])
  wardArea WardArea? @relation(fields: [wardAreaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([wardId])
  @@index([wardAreaId])
  @@index([isDeleted])
  @@index([type])
  @@map("community_groups")
}

// ════════════════════════════════════════════════════════
// DEMOGRAPHICS
// ════════════════════════════════════════════════════════

model Demographics {
  id         String  @id @default(cuid())
  tenantId   String
  wardId     String
  wardAreaId String? // null = ward-level, set = area-level

  // Population
  totalPopulation  Int @default(0)
  maleCount        Int @default(0)
  femaleCount      Int @default(0)
  transgenderCount Int @default(0)

  // Age Distribution
  age0to6   Int @default(0)
  age7to18  Int @default(0)
  age19to35 Int @default(0)
  age36to60 Int @default(0)
  age60plus Int @default(0)

  // Households
  totalHouseholds Int @default(0)
  bplHouseholds   Int @default(0)
  aplHouseholds   Int @default(0)

  // Social Category Distribution
  generalCount       Int @default(0)
  obcCount           Int @default(0)
  scCount            Int @default(0)
  stCount            Int @default(0)
  minorityCount      Int @default(0)
  otherCount         Int @default(0)
  // ═══ Religion Distribution (NEW) ═══
  hinduCount         Int @default(0)
  muslimCount        Int @default(0)
  sikhCount          Int @default(0)
  christianCount     Int @default(0)
  buddhistCount      Int @default(0)
  jainCount          Int @default(0)
  otherReligionCount Int @default(0)

  // Literacy & Education
  literacyRate       Float?
  maleLiteracyRate   Float?
  femaleLiteracyRate Float?

  // Voters
  totalVoters    Int @default(0)
  maleVoters     Int @default(0)
  femaleVoters   Int @default(0)
  newVotersCount Int @default(0)

  // Vital Statistics
  totalBirths Int @default(0)
  totalDeaths Int @default(0)

  // Source & Date
  surveyDate DateTime @default(now())
  source     String? // "Census 2021", "Ward Survey 2024", etc.
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward     Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  wardArea WardArea? @relation(fields: [wardAreaId], references: [id], onDelete: SetNull)

  @@unique([tenantId, wardId, wardAreaId])
  @@index([tenantId])
  @@index([wardId])
  @@index([wardAreaId])
  @@map("demographics")
}

// ════════════════════════════════════════════════════════
// GRIEVANCES
// ════════════════════════════════════════════════════════
model Grievance {
  id           String            @id @default(cuid())
  tenantId     String
  ticketNumber String
  subject      String            @default("")
  category     String
  subcategory  String?
  description  String
  wardId       String
  assignedDept String?
  assignedToId String?
  status       GrievanceStatus   @default(OPEN)
  isDeleted    Boolean           @default(false)
  priority     GrievancePriority @default(MEDIUM)
  source       String            @default("OFFICE")

  complainantName    String?
  complainantPhone   String?
  complainantEmail   String?
  complainantAddress String?

  locationAddress String?
  latitude        Float?
  longitude       Float?

  resolutionNotes        String?
  rejectionReason        String?
  resolvedAt             DateTime?
  closedAt               DateTime?
  escalatedAt            DateTime?
  escalationReason       String?
  expectedResolutionDate DateTime?
  satisfactionRating     Int?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward       Ward  @relation(fields: [wardId], references: [id])
  createdBy  User? @relation("GrievanceCreatedBy", fields: [createdById], references: [id])
  assignedTo User? @relation("GrievanceAssignedTo", fields: [assignedToId], references: [id])

  timeline     GrievanceTimeline[]
  attachments  GrievanceAttachment[]
  // department   Department?           @relation(fields: [departmentId], references: [id])
  departmentId String?
  department   Department?           @relation(fields: [departmentId], references: [id])

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@index([wardId])
  @@index([status])
  @@index([isDeleted])
  @@index([priority])
  @@index([assignedDept])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([ticketNumber])
  @@map("grievances")
}

model GrievanceTimeline {
  id          String           @id @default(cuid())
  grievanceId String
  action      String           @default("STATUS_CHANGE")
  fromStatus  GrievanceStatus?
  toStatus    GrievanceStatus?
  comment     String?
  changedBy   String?
  changedById String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([grievanceId])
  @@map("grievance_timeline")
}

model GrievanceAttachment {
  id          String   @id @default(cuid())
  grievanceId String
  fileUrl     String
  fileName    String
  fileType    String?
  fileSize    Int?
  createdAt   DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@map("grievance_attachments")
}

// ════════════════════════════════════════════════════════
// PROJECTS
// ════════════════════════════════════════════════════════

model Project {
  id              String  @id @default(cuid())
  tenantId        String
  projectCode     String
  name            String
  category        String
  department      String
  contractor      String?
  contractorPhone String?
  wardId          String

  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?

  budgetSanctioned Float    @default(0)
  budgetReleased   Float    @default(0)
  budgetUsed       Float    @default(0)
  fundType         FundType @default(OTHER)

  status            ProjectStatus @default(PENDING)
  isDeleted         Boolean       @default(false)
  completionPercent Int           @default(0)

  description String?
  address     String?
  latitude    Float?
  longitude   Float?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward        Ward                @relation(fields: [wardId], references: [id])
  createdBy   User?               @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  milestones  ProjectMilestone[]
  updates     ProjectUpdate[]
  attachments ProjectAttachment[]

  @@unique([tenantId, projectCode])
  @@index([tenantId])
  @@index([wardId])
  @@index([status])
  @@index([isDeleted])
  @@index([department])
  @@index([createdAt])
  @@map("projects")
}

model ProjectMilestone {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  description   String?
  targetDate    DateTime?
  completedDate DateTime?
  isCompleted   Boolean   @default(false)
  orderIndex    Int       @default(0)
  createdAt     DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectUpdate {
  id         String   @id @default(cuid())
  projectId  String
  updateText String
  updatedBy  String
  photoUrl   String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_updates")
}

model ProjectAttachment {
  id        String   @id @default(cuid())
  projectId String
  fileUrl   String
  fileName  String
  fileType  String?
  fileSize  Int?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_attachments")
}

