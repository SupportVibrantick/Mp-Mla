generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════

enum UserRole {
  SYSTEM_ADMIN
  MLA_MP
  OFFICE_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PENDING
  RUNNING
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
  REJECTED
}

enum GrievancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  CLOSED
  PROPOSED
}

enum InstitutionCategory {
  TEMPLE
  MOSQUE
  GURUDWARA
  CHURCH
  HOSPITAL
  CLINIC
  SCHOOL
  COLLEGE
  UNIVERSITY
  COACHING_CENTER
  POLICE_STATION
  GOVT_OFFICE
  NGO
  GYM
  SPORTS_FACILITY
  COMMUNITY_HALL
  LIBRARY
  MARKET
  RWA
  OLD_AGE_HOME
  OTHER
}

enum CommunityGroupType {
  MARKET
  SLUM
  SPORTS_TEAM
  CLUB
  RWA
  SENIOR_CITIZEN
  BUDDHIJEEVI
  WOMEN_GROUP
  YOUTH_GROUP
  CULTURAL_ORG
  NGO
  FESTIVAL_COMMITTEE
  TRADE_UNION
  OTHER
}

enum SchemeStatus {
  ACTIVE
  EXPIRED
  UPCOMING
  SUSPENDED
}

enum FundType {
  MPLAD
  MLALAD
  STATE_FUND
  CENTRAL_FUND
  CSR
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  IMPORT
  PASSWORD_CHANGE
  PERMISSION_CHANGE
  STATUS_CHANGE
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SEND_NOTIFICATION
  BACKUP
  RESTORE
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WardStatus {
  ACTIVE
  INACTIVE
  PROPOSED
  MERGED
  DELIMITATION_PENDING
}

enum WardAreaType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  AGRICULTURAL
  INSTITUTIONAL
  SLUM
  CANTONMENT
  OTHER
}

enum SocialCategory {
  GENERAL
  OBC
  SC
  ST
  MINORITY
  OTHER
}

// ════════════════════════════════════════════════════════
// ORGANIZATION & BRANDING
// ════════════════════════════════════════════════════════

model Organization {
  id               String  @id @default(cuid())
  name             String
  tagline          String?
  constituencyName String
  state            String
  district         String
  address          String?
  phone            String?
  email            String?
  website          String?
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String  @default("#1e40af")
  secondaryColor   String  @default("#3b82f6")

  representativeName  String
  representativeTitle String
  representativePhoto String?
  partyName           String?
  partyLogoUrl        String?
  termStartDate       DateTime?
  termEndDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// ════════════════════════════════════════════════════════
// USERS & AUTH
// ════════════════════════════════════════════════════════

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  phone     String?    @unique
  password  String
  name      String
  role      UserRole
  status    UserStatus @default(ACTIVE)
  avatarUrl String?

  // Security
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime  @default(now())
  forcePasswordChange Boolean   @default(false)

  // Who created this user
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdByAdmin User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  usersCreated   User[] @relation("UserCreatedBy")

  permissions        UserPermission[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  tasksAssigned      Task[]           @relation("TaskAssignedTo")
  tasksCreated       Task[]           @relation("TaskCreatedBy")
  grievancesCreated  Grievance[]      @relation("GrievanceCreatedBy")
  grievancesAssigned Grievance[]      @relation("GrievanceAssignedTo")
  projectsCreated    Project[]        @relation("ProjectCreatedBy")
  notifications      Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ════════════════════════════════════════════════════════
// PERMISSIONS (Database-driven RBAC)
// ════════════════════════════════════════════════════════

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  description String?

  roleDefaults    RoleDefaultPermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RoleDefaultPermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String
  granted      Boolean  @default(true)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_default_permissions")
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ════════════════════════════════════════════════════════
// WARDS
// ════════════════════════════════════════════════════════

model Ward {
  id         String     @id @default(cuid())
  wardNumber Int        @unique
  name       String     @unique
  zone       String? // "A", "B", "C" etc.
  status     WardStatus @default(ACTIVE)

  // Aggregate fields (computed from areas, cached for performance)
  totalPopulation Int @default(0)
  totalHouseholds Int @default(0)
  totalAreas      Int @default(0)
  totalMale       Int @default(0)
  totalFemale     Int @default(0)

  areaType        String    @default("Urban") // Overall classification
  pincode         String?
  latitude        Float?
  longitude       Float?
  boundaryGeoJson Json? // GeoJSON polygon for map rendering
  description     String?
  establishedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  areas               WardArea[]
  councillors         WardCouncillor[]
  institutions        Institution[]
  grievances          Grievance[]
  projects            Project[]
  demographics        Demographics[]
  communityGroups     CommunityGroup[]
  schemeBeneficiaries SchemeBeneficiary[]
  leaders             Leader[]

  @@index([status])
  @@index([zone])
  @@map("wards")
}

model WardArea {
  id          String       @id @default(cuid())
  wardId      String
  name        String
  areaType    WardAreaType @default(RESIDENTIAL)
  population  Int          @default(0)
  households  Int          @default(0)
  maleCount   Int          @default(0)
  femaleCount Int          @default(0)
  pincode     String?
  landmark    String?
  description String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward            Ward             @relation(fields: [wardId], references: [id], onDelete: Cascade)
  demographics    Demographics[]
  communityGroups CommunityGroup[]

  @@unique([wardId, name])
  @@index([wardId])
  @@index([areaType])
  @@map("ward_areas")
}

model WardCouncillor {
  id          String    @id @default(cuid())
  wardId      String
  name        String
  phone       String?
  email       String?
  partyName   String?
  photoUrl    String?
  address     String?
  designation String    @default("Ward Councillor")
  sinceDate   DateTime?
  untilDate   DateTime? // null = currently active
  isCurrent   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@index([wardId])
  @@index([isCurrent])
  @@map("ward_councillors")
}

// ════════════════════════════════════════════════════════
// INSTITUTIONS
// ════════════════════════════════════════════════════════

model Institution {
  id              String              @id @default(cuid())
  name            String
  category        InstitutionCategory
  subcategory     String?
  address         String
  latitude        Float?
  longitude       Float?
  wardId          String
  contactNo       String?
  email           String?
  website         String?
  status          InstitutionStatus   @default(ACTIVE)
  description     String?
  photoUrl        String?
  capacity        Int?
  establishedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward      Ward       @relation(fields: [wardId], references: [id])
  incharges Incharge[]

  @@index([wardId])
  @@index([category])
  @@index([status])
  @@map("institutions")
}

model Incharge {
  id            String    @id @default(cuid())
  institutionId String
  name          String
  designation   String
  contactNo     String
  email         String?
  dateOfBirth   DateTime?
  photoUrl      String?
  appointedDate DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("incharges")
}

// ════════════════════════════════════════════════════════
// COMMUNITY GROUPS
// ════════════════════════════════════════════════════════

model CommunityGroup {
  id              String             @id @default(cuid())
  name            String
  type            CommunityGroupType
  wardId          String
  wardAreaId      String? // optional: linked to specific area
  address         String?
  description     String?
  memberCount     Int?
  maleMembers     Int?
  femaleMembers   Int?
  headName        String?
  headPhone       String?
  headEmail       String?
  headDesignation String?
  headPhotoUrl    String?
  foundedDate     DateTime?
  registrationNo  String?
  isActive        Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward     Ward      @relation(fields: [wardId], references: [id])
  wardArea WardArea? @relation(fields: [wardAreaId], references: [id], onDelete: SetNull)

  @@index([wardId])
  @@index([wardAreaId])
  @@index([type])
  @@map("community_groups")
}

// ════════════════════════════════════════════════════════
// DEMOGRAPHICS
// ════════════════════════════════════════════════════════

model Demographics {
  id         String  @id @default(cuid())
  wardId     String
  wardAreaId String? // null = ward-level, set = area-level

  // Population
  totalPopulation  Int @default(0)
  maleCount        Int @default(0)
  femaleCount      Int @default(0)
  transgenderCount Int @default(0)

  // Age Distribution
  age0to6   Int @default(0)
  age7to18  Int @default(0)
  age19to35 Int @default(0)
  age36to60 Int @default(0)
  age60plus Int @default(0)

  // Households
  totalHouseholds Int @default(0)
  bplHouseholds   Int @default(0)
  aplHouseholds   Int @default(0)

  // Social Category Distribution
  generalCount       Int @default(0)
  obcCount           Int @default(0)
  scCount            Int @default(0)
  stCount            Int @default(0)
  minorityCount      Int @default(0)
  otherCount         Int @default(0)
  // ═══ Religion Distribution (NEW) ═══
  hinduCount         Int @default(0)
  muslimCount        Int @default(0)
  sikhCount          Int @default(0)
  christianCount     Int @default(0)
  buddhistCount      Int @default(0)
  jainCount          Int @default(0)
  otherReligionCount Int @default(0)

  // Literacy & Education
  literacyRate       Float?
  maleLiteracyRate   Float?
  femaleLiteracyRate Float?

  // Voters
  totalVoters  Int @default(0)
  maleVoters   Int @default(0)
  femaleVoters Int @default(0)

  // Source & Date
  surveyDate DateTime @default(now())
  source     String? // "Census 2021", "Ward Survey 2024", etc.
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward     Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  wardArea WardArea? @relation(fields: [wardAreaId], references: [id], onDelete: SetNull)

  @@unique([wardId, wardAreaId])
  @@index([wardId])
  @@index([wardAreaId])
  @@map("demographics")
}

// ════════════════════════════════════════════════════════
// GRIEVANCES
// ════════════════════════════════════════════════════════
model Grievance {
  id           String            @id @default(cuid())
  ticketNumber String            @unique
  subject      String            @default("")
  category     String
  subcategory  String?
  description  String
  wardId       String
  assignedDept String?
  assignedToId String?
  status       GrievanceStatus   @default(OPEN)
  priority     GrievancePriority @default(MEDIUM)
  source       String            @default("OFFICE")

  complainantName    String?
  complainantPhone   String?
  complainantEmail   String?
  complainantAddress String?

  locationAddress String?
  latitude        Float?
  longitude       Float?

  resolutionNotes        String?
  rejectionReason        String?
  resolvedAt             DateTime?
  closedAt               DateTime?
  escalatedAt            DateTime?
  escalationReason       String?
  expectedResolutionDate DateTime?
  satisfactionRating     Int?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward       Ward  @relation(fields: [wardId], references: [id])
  createdBy  User? @relation("GrievanceCreatedBy", fields: [createdById], references: [id])
  assignedTo User? @relation("GrievanceAssignedTo", fields: [assignedToId], references: [id])

  timeline     GrievanceTimeline[]
  attachments  GrievanceAttachment[]
  department   Department?           @relation(fields: [departmentId], references: [id])
  departmentId String?

  @@index([wardId])
  @@index([status])
  @@index([priority])
  @@index([assignedDept])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([ticketNumber])
  @@map("grievances")
}

model GrievanceTimeline {
  id          String           @id @default(cuid())
  grievanceId String
  action      String           @default("STATUS_CHANGE")
  fromStatus  GrievanceStatus?
  toStatus    GrievanceStatus?
  comment     String?
  changedBy   String?
  changedById String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([grievanceId])
  @@map("grievance_timeline")
}

model GrievanceAttachment {
  id          String   @id @default(cuid())
  grievanceId String
  fileUrl     String
  fileName    String
  fileType    String?
  fileSize    Int?
  createdAt   DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@map("grievance_attachments")
}

// ════════════════════════════════════════════════════════
// PROJECTS
// ════════════════════════════════════════════════════════

model Project {
  id              String  @id @default(cuid())
  projectCode     String  @unique
  name            String
  category        String
  department      String
  contractor      String?
  contractorPhone String?
  wardId          String

  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?

  budgetSanctioned Float    @default(0)
  budgetReleased   Float    @default(0)
  budgetUsed       Float    @default(0)
  fundType         FundType @default(OTHER)

  status            ProjectStatus @default(PENDING)
  completionPercent Int           @default(0)

  description String?
  address     String?
  latitude    Float?
  longitude   Float?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward        Ward                @relation(fields: [wardId], references: [id])
  createdBy   User?               @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  milestones  ProjectMilestone[]
  updates     ProjectUpdate[]
  attachments ProjectAttachment[]

  @@index([wardId])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@map("projects")
}

model ProjectMilestone {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  description   String?
  targetDate    DateTime?
  completedDate DateTime?
  isCompleted   Boolean   @default(false)
  orderIndex    Int       @default(0)
  createdAt     DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectUpdate {
  id         String   @id @default(cuid())
  projectId  String
  updateText String
  updatedBy  String
  photoUrl   String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_updates")
}

model ProjectAttachment {
  id        String   @id @default(cuid())
  projectId String
  fileUrl   String
  fileName  String
  fileType  String?
  fileSize  Int?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_attachments")
}

// ════════════════════════════════════════════════════════
// SCHEMES
// ════════════════════════════════════════════════════════

model Scheme {
  id             String       @id @default(cuid())
  name           String
  department     String
  level          String       @default("Central")
  description    String?
  eligibility    String?
  benefits       String?
  applicationUrl String?
  budget         Float        @default(0)
  status         SchemeStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries SchemeBeneficiary[]

  @@map("schemes")
}

model SchemeBeneficiary {
  id               String   @id @default(cuid())
  schemeId         String
  wardId           String
  beneficiaryCount Int      @default(0)
  targetCount      Int      @default(0)
  amountDisbursed  Float    @default(0)
  reportDate       DateTime @default(now())

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id])

  @@unique([schemeId, wardId])
  @@index([schemeId])
  @@index([wardId])
  @@map("scheme_beneficiaries")
}

// ════════════════════════════════════════════════════════
// DEPARTMENTS (Configurable)
// ════════════════════════════════════════════════════════

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?
  headName    String?
  headPhone   String?
  headEmail   String?
  isActive    Boolean @default(true)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  grievances Grievance[]

  @@map("departments")
}

// leaders 

// Add to schema.prisma

enum LeaderCategory {
  PARTY_LEADER
  OPPOSITION_LEADER
  BUREAUCRAT
  COMMUNITY_LEADER
  RELIGIOUS_LEADER
  BUSINESS_LEADER
  MEDIA_PERSON
  YOUTH_LEADER
  WOMEN_LEADER
  SENIOR_CITIZEN
  ACADEMIC
  LEGAL
  MEDICAL
  NGO_HEAD
  TRADE_UNION
  OTHER
}

model Leader {
  id           String         @id @default(cuid())
  name         String
  category     LeaderCategory
  designation  String?
  organization String?
  partyName    String?

  // Personal
  dateOfBirth DateTime
  gender      String?
  photoUrl    String?
  address     String?
  wardId      String?

  // Contact
  phone    String?
  altPhone String?
  email    String?
  whatsapp String?

  // Social
  facebookUrl  String?
  twitterUrl   String?
  instagramUrl String?

  // Relations
  relation  String? // "Supporter", "Neutral", "Alliance"
  influence String? // "High", "Medium", "Low"
  notes     String?
  tags      String[]
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward      Ward?            @relation(fields: [wardId], references: [id])
  greetings LeaderGreeting[]

  @@index([dateOfBirth])
  @@index([category])
  @@index([wardId])
  @@index([isActive])
  @@map("leaders")
}

model LeaderGreeting {
  id         String              @id @default(cuid())
  leaderId   String
  type       String // "BIRTHDAY", "FESTIVAL", "ACHIEVEMENT", "CUSTOM"
  channel    NotificationChannel // SMS, EMAIL, WHATSAPP, IN_APP
  message    String
  status     NotificationStatus  @default(PENDING)
  sentAt     DateTime?
  sentBy     String?
  failReason String?
  year       Int // Track which year greeting was sent

  createdAt DateTime @default(now())

  leader Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  @@index([leaderId])
  @@index([type, year])
  @@map("leader_greetings")
}

// ════════════════════════════════════════════════════════
// FUNDS
// ════════════════════════════════════════════════════════

model Fund {
  id             String   @id @default(cuid())
  fundType       FundType
  financialYear  String
  totalAllocated Float    @default(0)
  totalReleased  Float    @default(0)
  totalUtilized  Float    @default(0)

  transactions FundTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundType, financialYear])
  @@map("funds")
}

model FundTransaction {
  id          String   @id @default(cuid())
  fundId      String
  amount      Float
  type        String // ALLOCATION, RELEASE, UTILIZATION
  description String?
  projectId   String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@map("fund_transactions")
}

// ════════════════════════════════════════════════════════
// TASKS
// ════════════════════════════════════════════════════════

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  assignedToId String
  createdById  String
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?
  completedAt  DateTime?
  grievanceId  String?
  projectId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ════════════════════════════════════════════════════════
// NOTIFICATIONS
// ════════════════════════════════════════════════════════

model Notification {
  id             String              @id @default(cuid())
  userId         String?
  channel        NotificationChannel
  title          String
  message        String
  status         NotificationStatus  @default(PENDING)
  recipientPhone String?
  recipientEmail String?
  sentAt         DateTime?
  readAt         DateTime?
  failReason     String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  name      String              @unique
  channel   NotificationChannel
  subject   String?
  body      String
  variables String[]
  isActive  Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ════════════════════════════════════════════════════════
// AUDIT LOGS
// ════════════════════════════════════════════════════════

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  module      String
  recordId    String?
  description String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════
// SYSTEM SETTINGS
// ════════════════════════════════════════════════════════

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  type        String  @default("string")
  group       String  @default("general")
  description String?

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ════════════════════════════════════════════════════════
// BACKUPS
// ════════════════════════════════════════════════════════

model Backup {
  id          String    @id @default(cuid())
  fileName    String
  fileSize    BigInt?
  fileUrl     String?
  status      String    @default("IN_PROGRESS")
  type        String    @default("MANUAL")
  triggeredBy String?
  notes       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("backups")
}
