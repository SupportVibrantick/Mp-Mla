// ════════════════════════════════════════════════════════
// DEPARTMENTS (Configurable)
// ════════════════════════════════════════════════════════

model Department {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  headName    String?
  headPhone   String?
  headEmail   String?
  isActive    Boolean @default(true)
  isDeleted   Boolean @default(false)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grievances      Grievance[]
  users           User[]
  tasks           Task[]
  projects        Project[]
  slas            DepartmentSLA[]
  janataTokens    JanataDarbarToken[]
  correspondences Correspondence[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isDeleted])
  @@map("departments")
}

model DepartmentSLA {
  id           String            @id @default(cuid())
  tenantId     String
  departmentId String
  priority     GrievancePriority
  slaHours     Int
  isActive     Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, priority])
  @@index([tenantId])
  @@index([departmentId])
  @@index([priority])
  @@map("department_slas")
}

// leaders 

// Add to schema.prisma

enum LeaderCategory {
  PARTY_LEADER
  OPPOSITION_LEADER
  BUREAUCRAT
  COMMUNITY_LEADER
  RELIGIOUS_LEADER
  BUSINESS_LEADER
  MEDIA_PERSON
  YOUTH_LEADER
  WOMEN_LEADER
  SENIOR_CITIZEN
  ACADEMIC
  LEGAL
  MEDICAL
  NGO_HEAD
  TRADE_UNION
  OTHER
}

model Leader {
  id           String         @id @default(cuid())
  tenantId     String
  name         String
  category     LeaderCategory
  designation  String?
  organization String?
  partyName    String?

  // Personal
  dateOfBirth DateTime
  adharNumber String?
  gender      String?
  photoUrl    String?
  address     String?
  wardId      String?

  // Contact
  phone    String?
  altPhone String?
  email    String?
  whatsapp String?

  // Social
  facebookUrl  String?
  twitterUrl   String?
  instagramUrl String?

  // Relations
  relation String? // "Supporter", "Neutral", "Alliance"
  // influence String? // "High", "Medium", "Low"
  notes    String?

  tags      String[]
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward      Ward?            @relation(fields: [wardId], references: [id])
  greetings LeaderGreeting[]

  @@unique([tenantId, adharNumber])
  @@index([tenantId])
  @@index([dateOfBirth])
  @@index([category])
  @@index([wardId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("leaders")
}

model LeaderGreeting {
  id         String              @id @default(cuid())
  tenantId   String
  leaderId   String
  type       String // "BIRTHDAY", "FESTIVAL", "ACHIEVEMENT", "CUSTOM"
  channel    NotificationChannel // SMS, EMAIL, WHATSAPP, IN_APP
  message    String
  status     NotificationStatus  @default(PENDING)
  sentAt     DateTime?
  sentBy     String?
  failReason String?
  year       Int // Track which year greeting was sent

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leader Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leaderId])
  @@index([type, year])
  @@map("leader_greetings")
}

// ════════════════════════════════════════════════════════
// FUNDS
// ════════════════════════════════════════════════════════

model Fund {
  id             String   @id @default(cuid())
  tenantId       String
  fundType       FundType
  financialYear  String
  totalAllocated Float    @default(0)
  totalReleased  Float    @default(0)
  totalUtilized  Float    @default(0)
  isDeleted      Boolean  @default(false)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions FundTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, fundType, financialYear])
  @@index([tenantId])
  @@index([isDeleted])
  @@map("funds")
}

model FundTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  fundId      String
  amount      Float
  type        String // ALLOCATION, RELEASE, UTILIZATION
  description String?
  projectId   String?
  date        DateTime @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fund    Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([fundId])
  @@index([projectId])
  @@index([isDeleted])
  @@map("fund_transactions")
}

// ════════════════════════════════════════════════════════
// TASKS
// ════════════════════════════════════════════════════════

model Task {
  id                  String       @id @default(cuid())
  tenantId            String
  taskCode            String
  title               String
  description         String?
  assignedToId        String
  createdById         String
  priority            TaskPriority @default(MEDIUM)
  status              TaskStatus   @default(TODO)
  dueDate             DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  completedById       String?
  grievanceId         String?
  projectId           String?
  departmentId        String?
  eventId             String?
  appointmentId       String?
  janataSessionId     String?
  janataTokenId       String?
  schemeApplicationId String?
  correspondenceId    String?
  isDeleted           Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        Department?          @relation(fields: [departmentId], references: [id])
  assignedTo        User                 @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy         User                 @relation("TaskCreatedBy", fields: [createdById], references: [id])
  grievance         Grievance?           @relation(fields: [grievanceId], references: [id])
  project           Project?             @relation(fields: [projectId], references: [id])
  event             Event?               @relation(fields: [eventId], references: [id])
  appointment       Appointment?         @relation(fields: [appointmentId], references: [id])
  janataSession     JanataDarbarSession? @relation(fields: [janataSessionId], references: [id], onDelete: SetNull)
  janataToken       JanataDarbarToken?   @relation(fields: [janataTokenId], references: [id], onDelete: SetNull)
  schemeApplication SchemeApplication?   @relation(fields: [schemeApplicationId], references: [id], onDelete: SetNull)
  correspondence    Correspondence?      @relation(fields: [correspondenceId], references: [id], onDelete: SetNull)
  timeline          TaskTimeline[]
  crmInteractions   CRMInteraction[]

  @@unique([tenantId, taskCode])
  @@index([tenantId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@index([grievanceId])
  @@index([projectId])
  @@index([eventId])
  @@index([appointmentId])
  @@index([janataSessionId])
  @@index([janataTokenId])
  @@index([schemeApplicationId])
  @@index([isDeleted])
  @@map("tasks")
}

// ════════════════════════════════════════════════════════
// NOTIFICATIONS
// ════════════════════════════════════════════════════════

model Notification {
  id             String              @id @default(cuid())
  tenantId       String
  userId         String?
  channel        NotificationChannel
  title          String
  message        String
  status         NotificationStatus  @default(PENDING)
  recipientPhone String?
  recipientEmail String?
  sentAt         DateTime?
  readAt         DateTime?
  failReason     String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  tenantId  String
  name      String
  channel   NotificationChannel
  subject   String?
  body      String
  variables String[]
  isActive  Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("notification_templates")
}

// ════════════════════════════════════════════════════════
// AUDIT LOGS
// ════════════════════════════════════════════════════════

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String?
  userId      String?
  action      AuditAction
  module      String
  recordId    String?
  description String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════
// SYSTEM SETTINGS
// ════════════════════════════════════════════════════════

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  type        String  @default("string")
  group       String  @default("general")
  description String?

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model TenantSetting {
  id          String  @id @default(cuid())
  tenantId    String
  key         String
  value       String
  type        String  @default("string")
  group       String  @default("general")
  description String?

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([group])
  @@map("tenant_settings")
}

model PlatformSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  type        String  @default("string")
  group       String  @default("general")
  description String?

  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("platform_settings")
}

// ════════════════════════════════════════════════════════
// BACKUPS
// ════════════════════════════════════════════════════════

model Backup {
  id          String    @id @default(cuid())
  fileName    String
  fileSize    BigInt?
  fileUrl     String?
  status      String    @default("IN_PROGRESS")
  type        String    @default("MANUAL")
  triggeredBy String?
  notes       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("backups")
}

// ════════════════════════════════════════════════════════
// DATA ACTIVITY (Export/Import Tracking)
// ════════════════════════════════════════════════════════

model DataActivity {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  userName    String
  action      String // "EXPORT" or "IMPORT"
  module      String // e.g. "grievance", "ward", "leader", etc.
  recordCount Int      @default(0)
  fileName    String?
  details     String? // Optional extra info
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([userId])
  @@map("data_activities")
}

model RecycleBinEntry {
  id           String    @id @default(cuid())
  tenantId     String
  module       String
  entityType   String
  recordId     String
  recordLabel  String?
  payload      Json
  deletedById  String?
  deletedAt    DateTime  @default(now())
  restoredById String?
  restoredAt   DateTime?

  @@index([tenantId])
  @@index([module])
  @@index([entityType])
  @@index([recordId])
  @@index([deletedAt])
  @@index([restoredAt])
  @@map("recycle_bin_entries")
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MeetingType {
  ONLINE
  OFFLINE
}

model Meeting {
  id          String        @id @default(cuid())
  tenantId    String
  title       String
  description String?
  date        DateTime
  time        String?
  type        MeetingType   @default(OFFLINE)
  location    String? // Used for OFFLINE meeting location or ONLINE fallback
  meetingLink String? // Used for ONLINE meeting link (Zoom, Meet, etc)
  status      MeetingStatus @default(SCHEDULED)
  attendees   String?
  organizedBy String?
  isDeleted   Boolean       @default(false)

  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([isDeleted])
  @@index([type])
  @@map("meetings")
}

// ════════════════════════════════════════════════════════
// COMPETITOR ANALYSIS
// ════════════════════════════════════════════════════════

enum CompetitorAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Competitor {
  id             String  @id @default(cuid())
  tenantId       String
  candidateName  String
  partyName      String
  partyLogoUrl   String?
  candidatePhoto String?
  designation    String?
  constituency   String?
  phone          String?
  email          String?
  facebookUrl    String?
  twitterUrl     String?
  instagramUrl   String?
  youtubeUrl     String?
  websiteUrl     String?
  notes          String?
  isActive       Boolean @default(true)
  isDeleted      Boolean @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metrics  CompetitorMetricEntry[]
  analyses CompetitorAnalysis[]

  @@index([tenantId])
  @@index([isDeleted])
  @@index([isActive])
  @@index([createdAt])
  @@map("competitors")
}

model CompetitorMetricEntry {
  id           String  @id @default(cuid())
  tenantId     String
  competitorId String
  category     String // VOTER_OUTREACH, GROUND_NETWORK, ISSUE_RESOLUTION, PUBLIC_SENTIMENT, DIGITAL_PRESENCE, EVENTS_ACTIVITIES, FINANCIAL_DEVELOPMENT
  metricKey    String // e.g. "rallies_held", "door_to_door_visits"
  metricLabel  String // Human-readable: "Rallies/Sabhas Held"
  value        Float
  unit         String? // "count", "percentage", "days", "currency"
  period       String // "2026-04" (YYYY-MM format)
  notes        String?
  source       String? // "field_workers", "news", "social_media"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, metricKey, period])
  @@index([tenantId])
  @@index([competitorId])
  @@index([category])
  @@index([period])
  @@map("competitor_metric_entries")
}

model OwnMetricEntry {
  id          String  @id @default(cuid())
  tenantId    String
  category    String // Same categories as competitor
  metricKey   String // e.g. "rallies_held", "social_media_followers"
  metricLabel String // Human-readable label
  value       Float
  unit        String? // "count", "percentage", "days", "currency"
  period      String // "2026-04" (YYYY-MM format)
  isAuto      Boolean @default(false) // true = system-computed, false = manual
  notes       String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricKey, period])
  @@index([tenantId])
  @@index([category])
  @@index([period])
  @@index([isAuto])
  @@map("own_metric_entries")
}

model CompetitorAnalysis {
  id           String                   @id @default(cuid())
  tenantId     String
  competitorId String
  status       CompetitorAnalysisStatus @default(PENDING)

  // Snapshot of data used for analysis
  ownMetricsSnapshot        Json? // Snapshot of own metrics at time of analysis
  competitorMetricsSnapshot Json? // Snapshot of competitor metrics at time of analysis

  // AI-generated analysis
  executiveSummary  String?
  metricComparisons Json? // Array of {metric, ours, theirs, gap, advantage, insight, recommendation}
  strengths         Json? // Array of strings
  weaknesses        Json? // Array of strings
  opportunities     Json? // Array of strings
  threats           Json? // Array of strings
  recommendations   Json? // Array of {priority, action, expectedImpact, timeline}
  overallScore      Float? // 0-100 competitive position score
  areasLeading      Int     @default(0)
  areasTrailing     Int     @default(0)
  areasTied         Int     @default(0)

  errorMessage String?

  triggeredById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitor   Competitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  chatMessages CompetitorChat[]

  @@index([tenantId])
  @@index([competitorId])
  @@index([status])
  @@index([createdAt])
  @@map("competitor_analyses")
}

model CompetitorChat {
  id         String @id @default(cuid())
  tenantId   String
  analysisId String
  role       String // "user" or "assistant"
  message    String

  createdById String?
  createdAt   DateTime @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analysis CompetitorAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([analysisId])
  @@index([createdAt])
  @@map("competitor_chats")
}

// ════════════════════════════════════════════════════════
// VOTER LIST (Demography / Electoral Roll)
// ════════════════════════════════════════════════════════

model Voter {
  id         String  @id @default(cuid())
  tenantId   String
  wardId     String
  wardAreaId String?
  boothId    String?

  // Electoral Roll Identity
  voterIdNumber String // EPIC number (unique per tenant)
  slNo          Int? // Serial number in voter list
  sectionNo     Int? // Part/Section number
  boothNo       Int? // Polling booth number

  // Personal Details
  name         String
  relativeName String? // Father/Husband name
  relationType String? // "F" (Father), "H" (Husband), "M" (Mother)
  gender       VoterGender
  age          Int?

  // Address
  houseNo  String?
  address  String?
  locality String?

  // Contact (optional)
  phone String?

  // Classification
  isDisabled Boolean @default(false)

  // Metadata
  status        String  @default("ACTIVE") // ACTIVE, DELETED, SHIFTED
  isDeleted     Boolean @default(false)
  uploadBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward        Ward           @relation(fields: [wardId], references: [id])
  wardArea    WardArea?      @relation(fields: [wardAreaId], references: [id], onDelete: SetNull)
  uploadBatch BulkUploadJob? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  booth       Booth?         @relation(fields: [boothId], references: [id], onDelete: SetNull)

  @@unique([tenantId, voterIdNumber])
  @@index([tenantId])
  @@index([wardId])
  @@index([wardAreaId])
  @@index([gender])
  @@index([age])
  @@index([boothNo])
  @@index([sectionNo])
  @@index([isDeleted])
  @@index([uploadBatchId])
  @@index([boothId])
  @@index([tenantId, wardId, boothNo])
  @@index([tenantId, wardId, sectionNo])
  @@map("voters")
}

model BulkUploadJob {
  id       String  @id @default(cuid())
  tenantId String
  module   String // "voters", "institutions", etc.
  fileName String?
  fileSize Int? // bytes

  status         BulkUploadStatus @default(PENDING)
  totalRows      Int              @default(0)
  processedRows  Int              @default(0)
  successCount   Int              @default(0)
  failedCount    Int              @default(0)
  duplicateCount Int              @default(0)

  // Error details — JSON array of { rowIndex, voterIdNumber?, field?, error }
  errors  Json  @default("[]")
  // Summary stats generated after completion
  summary Json?

  startedAt      DateTime?
  completedAt    DateTime?
  uploadedById   String?
  uploadedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voters Voter[]

  @@index([tenantId])
  @@index([status])
  @@index([module])
  @@index([createdAt])
  @@map("bulk_upload_jobs")
}

// ════════════════════════════════════════════════════════
// CONSTITUENCY & GEOGRAPHY (Phase 3)
// ════════════════════════════════════════════════════════

enum ConstituencyType {
  ASSEMBLY
  PARLIAMENTARY
}

enum GeographyImportStatus {
  PENDING
  VALIDATING
  PREVIEW
  IMPORTING
  COMPLETED
  FAILED
  PARTIAL
}

model Constituency {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  type        ConstituencyType @default(ASSEMBLY)
  districtId  String?
  description String?
  latitude    Float?
  longitude   Float?
  boundary    Json?
  isActive    Boolean          @default(true)
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  district        District?               @relation(fields: [districtId], references: [id], onDelete: SetNull)
  representatives RepresentativeProfile[]

  townVillages TownVillage[]

  wards             Ward[]
  booths            Booth[]
  constituencyWards ConstituencyWard[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("constituencies")
}

model RepresentativeProfile {
  id             String @id @default(cuid())
  tenantId       String
  constituencyId String @unique

  name     String
  title    String
  photoUrl String?

  partyName    String?
  partyLogoUrl String?

  termStartDate DateTime?
  termEndDate   DateTime?

  officePhone   String?
  officeEmail   String?
  officeAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  constituency Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, constituencyId])
  @@index([tenantId])
  @@map("representative_profiles")
}

model District {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  state       String
  description String?
  latitude    Float?
  longitude   Float?
  boundary    Json?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  constituencies Constituency[]
  blocks         Block[]
  townVillages   TownVillage[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("districts")
}

model Block {
  id          String    @id @default(cuid())
  tenantId    String
  districtId  String
  name        String
  code        String?
  description String?
  latitude    Float?
  longitude   Float?
  boundary    Json?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  district     District      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  townVillages TownVillage[]

  @@unique([tenantId, districtId, name])
  @@unique([tenantId, districtId, code])
  @@index([tenantId])
  @@index([tenantId, districtId])
  @@map("blocks")
}

model TownVillage {
  id         String @id @default(cuid())
  tenantId   String
  districtId String

  // Optional because urban towns don't belong to a Block
  blockId String?

  // Constituency in which this town/village currently falls
  constituencyId String?

  name String
  code String?

  type   TownVillageType @default(VILLAGE)
  nature GeographyNature @default(RURAL)

  description String?
  pincode     String?
  latitude    Float?
  longitude   Float?
  boundary    Json?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  block Block? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  constituency Constituency? @relation(fields: [constituencyId], references: [id], onDelete: SetNull)

  wards  Ward[]
  booths Booth[]

  @@unique([tenantId, districtId, name])
  @@unique([tenantId, districtId, code])
  @@index([tenantId])
  @@index([tenantId, districtId])
  @@index([tenantId, constituencyId])
  @@index([tenantId, blockId])
  @@index([tenantId, type])
  @@index([tenantId, nature])
  @@index([isDeleted])
  @@map("town_villages")
}

model PollingLocation {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  code         String?
  description  String?
  address      String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  buildingName String?
  landmark     String?
  isAccessible Boolean   @default(true)
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booths Booth[]

  @@index([tenantId])
  @@map("polling_locations")
}

model Booth {
  id       String @id @default(cuid())
  tenantId String

  constituencyId String

  wardId        String?
  townVillageId String?

  pollingLocationId String?

  boothNumber Int
  boothName   String
  code        String?
  description String?

  latitude  Float?
  longitude Float?
  boundary  Json?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  constituency Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)

  ward Ward? @relation(fields: [wardId], references: [id], onDelete: SetNull)

  townVillage TownVillage? @relation(fields: [townVillageId], references: [id], onDelete: SetNull)

  pollingLocation PollingLocation? @relation(fields: [pollingLocationId], references: [id], onDelete: SetNull)

  voters Voter[]

  @@unique([tenantId, constituencyId, boothNumber])
  @@index([tenantId])
  @@index([tenantId, constituencyId])
  @@index([tenantId, wardId])
  @@index([tenantId, townVillageId])
  @@index([tenantId, pollingLocationId])
  @@map("booths")
}

model ConstituencyWard {
  id             String   @id @default(cuid())
  tenantId       String
  constituencyId String
  wardId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  constituency Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  ward         Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([constituencyId, wardId])
  @@index([tenantId])
  @@map("constituency_wards")
}

model GeographyImportJob {
  id             String                @id @default(cuid())
  tenantId       String
  fileName       String?
  fileSize       Int?
  status         GeographyImportStatus @default(PENDING)
  totalRows      Int                   @default(0)
  processedRows  Int                   @default(0)
  successCount   Int                   @default(0)
  failedCount    Int                   @default(0)
  errors         Json                  @default("[]")
  summary        Json?
  startedAt      DateTime?
  completedAt    DateTime?
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("geography_import_jobs")
}

model ProjectTimeline {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  action      String
  comment     String?
  metadata    Json?
  changedById String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([createdAt])
  @@map("project_timelines")
}

model TaskTimeline {
  id          String   @id @default(cuid())
  tenantId    String
  taskId      String
  action      String
  comment     String?
  metadata    Json?
  changedById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([taskId])
  @@index([createdAt])
  @@map("task_timelines")
}

enum EventType {
  PUBLIC_MEETING
  JANATA_DARBAR
  CONSTITUENCY_VISIT
  VILLAGE_VISIT
  DEVELOPMENT_INAUGURATION
  PUBLIC_HEARING
  OFFICIAL_MEETING
  COMMUNITY_EVENT
  PRESS_CONFERENCE
}

enum EventStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
}

enum EventMode {
  OFFLINE
  ONLINE
  HYBRID
}

model Event {
  id          String      @id @default(cuid())
  tenantId    String
  eventCode   String
  title       String
  description String?
  type        EventType
  status      EventStatus @default(DRAFT)
  mode        EventMode   @default(OFFLINE)

  startDate DateTime
  endDate   DateTime?

  location    String?
  address     String?
  meetingLink String? // Added to support ONLINE/HYBRID modes
  latitude    Float?
  longitude   Float?

  wardId      String?
  organizerId String?
  isDeleted   Boolean @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward            Ward?             @relation(fields: [wardId], references: [id], onDelete: SetNull)
  organizer       User?             @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  agenda          EventAgenda[]
  guests          EventGuest[]
  team            EventTeamMember[]
  attendance      EventAttendance[]
  media           EventMedia[]
  report          EventReport?
  tasks           Task[]
  timeline        EventTimeline[]
  crmInteractions CRMInteraction[]

  @@unique([tenantId, eventCode])
  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([startDate])
  @@index([wardId])
  @@index([organizerId])
  @@index([isDeleted])
  @@map("events")
}

model EventTeamMember {
  id         String   @id @default(cuid())
  tenantId   String
  eventId    String
  userId     String
  role       String?
  assignedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([tenantId])
  @@index([eventId])
  @@index([userId])
  @@map("event_team_members")
}

model EventAgenda {
  id          String    @id @default(cuid())
  tenantId    String
  eventId     String
  title       String
  description String?
  orderIndex  Int       @default(0)
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@map("event_agendas")
}

model EventGuest {
  id               String   @id @default(cuid())
  tenantId         String
  eventId          String
  name             String
  designation      String?
  organization     String?
  phone            String?
  email            String?
  invitationStatus String?
  attendanceStatus String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@map("event_guests")
}

model EventAttendance {
  id           String    @id @default(cuid())
  tenantId     String
  eventId      String
  name         String
  phone        String?
  category     String?
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@map("event_attendances")
}

enum EventMediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

model EventMedia {
  id           String         @id @default(cuid())
  tenantId     String
  eventId      String
  type         EventMediaType
  fileUrl      String
  fileName     String
  fileType     String?
  fileSize     Int?
  caption      String?
  uploadedById String?
  createdAt    DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@index([type])
  @@map("event_media")
}

model EventReport {
  id              String   @id @default(cuid())
  tenantId        String
  eventId         String   @unique
  summary         String?
  highlights      String?
  issues          String?
  decisions       String?
  outcomes        String?
  remarks         String?
  attendanceCount Int      @default(0)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_reports")
}

model EventTimeline {
  id          String   @id @default(cuid())
  tenantId    String
  eventId     String
  action      String
  description String?
  changedById String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@index([createdAt])
  @@map("event_timelines")
}

enum AppointmentType {
  MLA_MP_MEETING
  PUBLIC_GRIEVANCE
  OFFICE_APPOINTMENT
  DEVELOPMENT_DISCUSSION
  OFFICIAL_MEETING
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

model Appointment {
  id                String            @id @default(cuid())
  tenantId          String
  appointmentNumber String
  title             String
  type              AppointmentType
  status            AppointmentStatus @default(PENDING)

  requesterName  String
  requesterPhone String?
  requesterEmail String?

  date      DateTime
  startTime String
  endTime   String

  location           String?
  purpose            String?
  notes              String?
  rejectionReason    String?
  cancellationReason String?

  approvedAt  DateTime?
  rejectedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdById  String?
  isDeleted    Boolean   @default(false)
  reminderSent Boolean   @default(false)
  reminderAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks           Task[]
  crmInteractions CRMInteraction[]

  @@unique([tenantId, appointmentNumber])
  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("appointments")
}

enum JanataSessionType {
  JANATA_DARBAR
  PUBLIC_HEARING
}

enum JanataSessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum JanataTokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  RESOLVED
  REFERRED
  ABSENT
}

model JanataDarbarSession {
  id            String              @id @default(cuid())
  tenantId      String
  sessionNumber String
  title         String
  type          JanataSessionType
  status        JanataSessionStatus @default(SCHEDULED)

  date        DateTime
  startTime   String
  endTime     String
  location    String
  description String?

  createdById String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tokens          JanataDarbarToken[]
  grievances      Grievance[]
  tasks           Task[]
  crmInteractions CRMInteraction[]

  @@unique([tenantId, sessionNumber])
  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([type])
  @@index([isDeleted])
  @@map("janata_darbar_sessions")
}

model JanataDarbarToken {
  id          String            @id @default(cuid())
  tenantId    String
  sessionId   String
  tokenNumber String // e.g. JD-001
  status      JanataTokenStatus @default(WAITING)

  visitorName String
  phone       String?
  address     String?
  purpose     String?
  notes       String?

  wardId            String?
  assignedOfficerId String?
  departmentId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session         JanataDarbarSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedOfficer User?               @relation("TokenOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  department      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ward            Ward?               @relation(fields: [wardId], references: [id], onDelete: SetNull)
  grievances      Grievance[]
  tasks           Task[]
  crmInteractions CRMInteraction[]

  @@unique([sessionId, tokenNumber])
  @@index([tenantId])
  @@index([sessionId])
  @@index([status])
  @@map("janata_darbar_tokens")
}

enum SchemeStatus {
  ACTIVE
  INACTIVE
  UPCOMING
  EXPIRED
}

enum SchemeLevel {
  CENTRAL
  STATE
  LOCAL
}

enum SchemeApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENT_PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Scheme {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  code       String?
  department String
  level      SchemeLevel @default(STATE)

  description       String?
  eligibility       String?
  benefits          String?
  requiredDocuments Json?
  applicationUrl    String?

  status SchemeStatus @default(ACTIVE)

  startDate DateTime?
  endDate   DateTime?

  isDeleted   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications SchemeApplication[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([department])
  @@index([status])
  @@index([isDeleted])
  @@map("schemes")
}

model SchemeApplication {
  id                String @id @default(cuid())
  tenantId          String
  schemeId          String
  applicationNumber String

  beneficiaryName  String
  beneficiaryPhone String?
  beneficiaryEmail String?
  address          String?
  wardId           String?

  status SchemeApplicationStatus @default(DRAFT)

  assignedToId    String?
  notes           String?
  rejectionReason String?
  followUpDate    DateTime?
  completedAt     DateTime?

  createdById String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheme          Scheme                      @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  assignedTo      User?                       @relation("SchemeApplicationOfficer", fields: [assignedToId], references: [id], onDelete: SetNull)
  ward            Ward?                       @relation(fields: [wardId], references: [id], onDelete: SetNull)
  documents       SchemeApplicationDocument[]
  grievances      Grievance[]
  tasks           Task[]
  crmInteractions CRMInteraction[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId])
  @@index([schemeId])
  @@index([status])
  @@index([assignedToId])
  @@index([wardId])
  @@index([followUpDate])
  @@index([isDeleted])
  @@map("scheme_applications")
}

model SchemeApplicationDocument {
  id            String @id @default(cuid())
  tenantId      String
  applicationId String

  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  documentType String?
  createdAt    DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application SchemeApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([applicationId])
  @@map("scheme_application_documents")
}

enum ContactCategory {
  CITIZEN
  COMMUNITY_LEADER
  ORGANIZATION
  NGO
  OFFICIAL
  BUSINESS
  MEDIA
  OTHER
}

enum InteractionChannel {
  CALL
  EMAIL
  SMS
  WHATSAPP
  OFFICE_VISIT
  LETTER
  MEETING
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Contact {
  id       String          @id @default(cuid())
  tenantId String
  name     String
  phone    String?
  email    String?
  address  String?
  wardId   String?
  category ContactCategory @default(CITIZEN)

  relationship   String?
  tags           String? // Comma-separated tags
  importantNotes String?

  isDeleted   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  ward         Ward?            @relation(fields: [wardId], references: [id], onDelete: SetNull)
  interactions CRMInteraction[]
  followUps    CRMFollowUp[]

  @@index([tenantId])
  @@index([category])
  @@index([isDeleted])
  @@map("crm_contacts")
}

model CRMInteraction {
  id        String             @id @default(cuid())
  tenantId  String
  contactId String
  channel   InteractionChannel
  date      DateTime           @default(now())
  summary   String
  details   String?

  grievanceId         String?
  appointmentId       String?
  eventId             String?
  janataSessionId     String?
  janataTokenId       String?
  schemeApplicationId String?
  taskId              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  grievance         Grievance?           @relation(fields: [grievanceId], references: [id], onDelete: SetNull)
  appointment       Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  event             Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  janataSession     JanataDarbarSession? @relation(fields: [janataSessionId], references: [id], onDelete: SetNull)
  janataToken       JanataDarbarToken?   @relation(fields: [janataTokenId], references: [id], onDelete: SetNull)
  schemeApplication SchemeApplication?   @relation(fields: [schemeApplicationId], references: [id], onDelete: SetNull)
  task              Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId])
  @@index([channel])
  @@index([date])
  @@map("crm_interactions")
}

model CRMFollowUp {
  id           String         @id @default(cuid())
  tenantId     String
  contactId    String
  followUpDate DateTime
  assignedToId String?
  purpose      String
  notes        String?
  status       FollowUpStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("FollowUpOfficer", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId])
  @@index([followUpDate])
  @@index([status])
  @@map("crm_follow_ups")
}

enum DocumentCategory {
  GENERAL
  GRIEVANCE
  PROJECT
  SCHEME
  EVENT
  MEETING
  APPOINTMENT
  LETTER
  APPLICATION
  GOVERNMENT
  FINANCIAL
  LEGAL
  REPORT
  OTHER
}

model Document {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  category    DocumentCategory @default(GENERAL)

  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  version      Int     @default(1)
  isDeleted    Boolean @default(false)
  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy              User?                    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  versions                DocumentVersion[]
  links                   DocumentLink[]
  correspondenceDocuments CorrespondenceDocument[]

  @@index([tenantId])
  @@index([category])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("documents")
}

model DocumentVersion {
  id         String  @id @default(cuid())
  documentId String
  version    Int
  fileName   String
  fileUrl    String
  fileType   String?
  fileSize   Int?

  uploadedById String?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentLink {
  id         String   @id @default(cuid())
  tenantId   String
  documentId String
  module     String
  recordId   String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@index([module, recordId])
  @@map("document_links")
}

enum CorrespondenceType {
  LETTER
  APPLICATION
  REQUEST
  REPRESENTATION
  COMPLAINT
  RECOMMENDATION
  OTHER
}

enum CorrespondenceStatus {
  RECEIVED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  REPLY_PENDING
  REPLIED
  COMPLETED
  REJECTED
  CLOSED
}

model Correspondence {
  id              String             @id @default(cuid())
  tenantId        String
  referenceNumber String
  type            CorrespondenceType
  subject         String
  description     String?

  senderName    String?
  senderPhone   String?
  senderEmail   String?
  senderAddress String?

  receivedDate DateTime  @default(now())
  dueDate      DateTime?

  status       CorrespondenceStatus @default(RECEIVED)
  assignedToId String?
  departmentId String?

  replyText   String?
  repliedAt   DateTime?
  completedAt DateTime?

  notes       String?
  isDeleted   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?                    @relation("CorrespondenceAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  department Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  documents  CorrespondenceDocument[]
  timeline   CorrespondenceTimeline[]
  tasks      Task[]

  @@unique([tenantId, referenceNumber])
  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([receivedDate])
  @@index([dueDate])
  @@index([isDeleted])
  @@map("correspondences")
}

model CorrespondenceDocument {
  id               String   @id @default(cuid())
  tenantId         String
  correspondenceId String
  documentId       String
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  correspondence Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([correspondenceId, documentId])
  @@index([tenantId])
  @@index([correspondenceId])
  @@index([documentId])
  @@map("correspondence_documents")
}

model CorrespondenceTimeline {
  id               String   @id @default(cuid())
  tenantId         String
  correspondenceId String
  action           String
  comment          String?
  changedById      String?
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  correspondence Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([correspondenceId])
  @@index([createdAt])
  @@map("correspondence_timeline")
}
