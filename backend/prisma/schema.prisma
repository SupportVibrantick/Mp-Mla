// ════════════════════════════════════════════════════════
// DEPARTMENTS (Configurable)
// ════════════════════════════════════════════════════════

model Department {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  headName    String?
  headPhone   String?
  headEmail   String?
  isActive    Boolean @default(true)
  isDeleted   Boolean @default(false)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grievances Grievance[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isDeleted])
  @@map("departments")
}

// leaders 

// Add to schema.prisma

enum LeaderCategory {
  PARTY_LEADER
  OPPOSITION_LEADER
  BUREAUCRAT
  COMMUNITY_LEADER
  RELIGIOUS_LEADER
  BUSINESS_LEADER
  MEDIA_PERSON
  YOUTH_LEADER
  WOMEN_LEADER
  SENIOR_CITIZEN
  ACADEMIC
  LEGAL
  MEDICAL
  NGO_HEAD
  TRADE_UNION
  OTHER
}

model Leader {
  id           String         @id @default(cuid())
  tenantId     String
  name         String
  category     LeaderCategory
  designation  String?
  organization String?
  partyName    String?

  // Personal
  dateOfBirth DateTime
  adharNumber String?
  gender      String?
  photoUrl    String?
  address     String?
  wardId      String?

  // Contact
  phone    String?
  altPhone String?
  email    String?
  whatsapp String?

  // Social
  facebookUrl  String?
  twitterUrl   String?
  instagramUrl String?

  // Relations
  relation  String? // "Supporter", "Neutral", "Alliance"
  // influence String? // "High", "Medium", "Low"
  notes     String?

  tags      String[]
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward      Ward?            @relation(fields: [wardId], references: [id])
  greetings LeaderGreeting[]

  @@unique([tenantId, adharNumber])
  @@index([tenantId])
  @@index([dateOfBirth])
  @@index([category])
  @@index([wardId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("leaders")
}

model LeaderGreeting {
  id         String              @id @default(cuid())
  leaderId   String
  type       String // "BIRTHDAY", "FESTIVAL", "ACHIEVEMENT", "CUSTOM"
  channel    NotificationChannel // SMS, EMAIL, WHATSAPP, IN_APP
  message    String
  status     NotificationStatus  @default(PENDING)
  sentAt     DateTime?
  sentBy     String?
  failReason String?
  year       Int // Track which year greeting was sent

  createdAt DateTime @default(now())

  leader Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  @@index([leaderId])
  @@index([type, year])
  @@map("leader_greetings")
}

// ════════════════════════════════════════════════════════
// FUNDS
// ════════════════════════════════════════════════════════

model Fund {
  id             String   @id @default(cuid())
  tenantId       String
  fundType       FundType
  financialYear  String
  totalAllocated Float    @default(0)
  totalReleased  Float    @default(0)
  totalUtilized  Float    @default(0)
  isDeleted      Boolean  @default(false)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions FundTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, fundType, financialYear])
  @@index([tenantId])
  @@index([isDeleted])
  @@map("funds")
}

model FundTransaction {
  id          String   @id @default(cuid())
  fundId      String
  amount      Float
  type        String // ALLOCATION, RELEASE, UTILIZATION
  description String?
  projectId   String?
  date        DateTime @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([isDeleted])
  @@map("fund_transactions")
}

// ════════════════════════════════════════════════════════
// TASKS
// ════════════════════════════════════════════════════════

model Task {
  id           String       @id @default(cuid())
  tenantId     String
  title        String
  description  String?
  assignedToId String
  createdById  String
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?
  completedAt  DateTime?
  grievanceId  String?
  projectId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ════════════════════════════════════════════════════════
// NOTIFICATIONS
// ════════════════════════════════════════════════════════

model Notification {
  id             String              @id @default(cuid())
  tenantId       String
  userId         String?
  channel        NotificationChannel
  title          String
  message        String
  status         NotificationStatus  @default(PENDING)
  recipientPhone String?
  recipientEmail String?
  sentAt         DateTime?
  readAt         DateTime?
  failReason     String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  tenantId  String
  name      String
  channel   NotificationChannel
  subject   String?
  body      String
  variables String[]
  isActive  Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("notification_templates")
}

// ════════════════════════════════════════════════════════
// AUDIT LOGS
// ════════════════════════════════════════════════════════

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String?
  userId      String?
  action      AuditAction
  module      String
  recordId    String?
  description String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════
// SYSTEM SETTINGS
// ════════════════════════════════════════════════════════

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  type        String  @default("string")
  group       String  @default("general")
  description String?

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model TenantSetting {
  id          String  @id @default(cuid())
  tenantId    String
  key         String
  value       String
  type        String  @default("string")
  group       String  @default("general")
  description String?

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([group])
  @@map("tenant_settings")
}

model PlatformSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  type        String  @default("string")
  group       String  @default("general")
  description String?

  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("platform_settings")
}

// ════════════════════════════════════════════════════════
// BACKUPS
// ════════════════════════════════════════════════════════

model Backup {
  id          String    @id @default(cuid())
  fileName    String
  fileSize    BigInt?
  fileUrl     String?
  status      String    @default("IN_PROGRESS")
  type        String    @default("MANUAL")
  triggeredBy String?
  notes       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("backups")
}

// ════════════════════════════════════════════════════════
// DATA ACTIVITY (Export/Import Tracking)
// ════════════════════════════════════════════════════════

model DataActivity {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  userName    String
  action      String // "EXPORT" or "IMPORT"
  module      String // e.g. "grievance", "ward", "leader", etc.
  recordCount Int      @default(0)
  fileName    String?
  details     String? // Optional extra info
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([userId])
  @@map("data_activities")
}

model RecycleBinEntry {
  id           String    @id @default(cuid())
  tenantId     String
  module       String
  entityType   String
  recordId     String
  recordLabel  String?
  payload      Json
  deletedById  String?
  deletedAt    DateTime  @default(now())
  restoredById String?
  restoredAt   DateTime?

  @@index([tenantId])
  @@index([module])
  @@index([entityType])
  @@index([recordId])
  @@index([deletedAt])
  @@index([restoredAt])
  @@map("recycle_bin_entries")
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MeetingType {
  ONLINE
  OFFLINE
}

model Meeting {
  id          String        @id @default(cuid())
  tenantId    String
  title       String
  description String?
  date        DateTime
  time        String?
  type        MeetingType   @default(OFFLINE)
  location    String? // Used for OFFLINE meeting location or ONLINE fallback
  meetingLink String? // Used for ONLINE meeting link (Zoom, Meet, etc)
  status      MeetingStatus @default(SCHEDULED)
  attendees   String?
  organizedBy String?
  isDeleted   Boolean       @default(false)

  reminderSent Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([isDeleted])
  @@index([type])
  @@map("meetings")
}

// ════════════════════════════════════════════════════════
// COMPETITOR ANALYSIS
// ════════════════════════════════════════════════════════

enum CompetitorAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Competitor {
  id              String   @id @default(cuid())
  tenantId        String
  candidateName   String
  partyName       String
  partyLogoUrl    String?
  candidatePhoto  String?
  designation     String?
  constituency    String?
  phone           String?
  email           String?
  facebookUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  youtubeUrl      String?
  websiteUrl      String?
  notes           String?
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metrics   CompetitorMetricEntry[]
  analyses  CompetitorAnalysis[]

  @@index([tenantId])
  @@index([isDeleted])
  @@index([isActive])
  @@index([createdAt])
  @@map("competitors")
}

model CompetitorMetricEntry {
  id            String   @id @default(cuid())
  competitorId  String
  category      String   // VOTER_OUTREACH, GROUND_NETWORK, ISSUE_RESOLUTION, PUBLIC_SENTIMENT, DIGITAL_PRESENCE, EVENTS_ACTIVITIES, FINANCIAL_DEVELOPMENT
  metricKey     String   // e.g. "rallies_held", "door_to_door_visits"
  metricLabel   String   // Human-readable: "Rallies/Sabhas Held"
  value         Float
  unit          String?  // "count", "percentage", "days", "currency"
  period        String   // "2026-04" (YYYY-MM format)
  notes         String?
  source        String?  // "field_workers", "news", "social_media"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, metricKey, period])
  @@index([competitorId])
  @@index([category])
  @@index([period])
  @@map("competitor_metric_entries")
}

model OwnMetricEntry {
  id          String  @id @default(cuid())
  tenantId    String
  category    String  // Same categories as competitor
  metricKey   String  // e.g. "rallies_held", "social_media_followers"
  metricLabel String  // Human-readable label
  value       Float
  unit        String? // "count", "percentage", "days", "currency"
  period      String  // "2026-04" (YYYY-MM format)
  isAuto      Boolean @default(false) // true = system-computed, false = manual
  notes       String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricKey, period])
  @@index([tenantId])
  @@index([category])
  @@index([period])
  @@index([isAuto])
  @@map("own_metric_entries")
}

model CompetitorAnalysis {
  id             String                   @id @default(cuid())
  competitorId   String
  status         CompetitorAnalysisStatus @default(PENDING)
  
  // Snapshot of data used for analysis
  ownMetricsSnapshot       Json?  // Snapshot of own metrics at time of analysis
  competitorMetricsSnapshot Json?  // Snapshot of competitor metrics at time of analysis

  // AI-generated analysis
  executiveSummary    String?
  metricComparisons   Json?    // Array of {metric, ours, theirs, gap, advantage, insight, recommendation}
  strengths           Json?    // Array of strings
  weaknesses          Json?    // Array of strings
  opportunities       Json?    // Array of strings
  threats             Json?    // Array of strings
  recommendations     Json?    // Array of {priority, action, expectedImpact, timeline}
  overallScore        Float?   // 0-100 competitive position score
  areasLeading        Int      @default(0)
  areasTrailing       Int      @default(0)
  areasTied           Int      @default(0)

  errorMessage String?
  
  triggeredById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  competitor Competitor     @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  chatMessages CompetitorChat[]

  @@index([competitorId])
  @@index([status])
  @@index([createdAt])
  @@map("competitor_analyses")
}

model CompetitorChat {
  id         String @id @default(cuid())
  analysisId String
  role       String // "user" or "assistant"
  message    String

  createdById String?
  createdAt   DateTime @default(now())

  analysis CompetitorAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([createdAt])
  @@map("competitor_chats")
}
